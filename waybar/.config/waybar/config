{
  "layer": "top",
  "position": "top",
  "margin-bottom": -15,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "user",
    "cpu",
    "memory"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/recorder",
    "mpris",
    "bluetooth",
    "custom/htb_vpn",
    "custom/htb_target",
    "network",
    "pulseaudio",
    "custom/notification",
    "custom/lock"
  ],
  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "\uf192",
      "default": "\uf111"
    }
  },
  "bluetooth": {
    "format": "\udb80\udcb2",
    "format-on": "{icon}",
    "format-off": "{icon}",
    "format-connected": "{icon}",
    "format-icons": {
      "on": "\udb80\udcaf",
      "off": "\udb80\udcb2",
      "connected": "\udb80\udcb1"
    },
    "on-click": "blueman-manager",
    "tooltip-format-connected": "{device_enumerate}"
  },
  "clock": {
    "timezone": "America/New_York",
    "tooltip": false,
    "format": "{:%H:%M:%S  \udb82\udcc7  %A, %d}",
    "interval": 1
  },
  "network": {
    "format-wifi": "\udb82\udd22",
    "format-ethernet": "\udb80\ude00 ",
    "format-disconnected": "\udb82\udd20 ",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "nm-connection-editor"
  },
  "cpu": {
    "interval": 1,
    "format": "\uf2db  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": [
      "\u2581",
      "\u2582",
      "\u2583",
      "\u2584",
      "\u2585",
      "\u2586",
      "\u2587",
      "\u2588"
    ],
    "on-click": "wezterm start btop"
  },
  "memory": {
    "interval": 1,
    "format": "\uefc5    {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "Memory"
  },
  "user": {
    "format": "\udb82\udd54  {work_H} : {work_M}",
    "format-icon": [
      "\uf062"
    ],
    "tooltip": false,
    "height": 10,
    "width": 10,
    "interval": 60,
    "icon": true
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "\uf466",
    "format-icons": {
      "default": [
        "\uf026",
        "\uf027",
        "\uf028 "
      ]
    },
    "on-click": "pavucontrol"
  },
  "custom/recorder": {
    "signal": 10,
    "format": "{}",
    "return-type": "json",
    "interval": 2,
    "exec": "~/.config/recorder/status.sh",
    "on-click": "~/.config/recorder/menu.sh",
    "tooltip": false
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "hyprlock",
    "format": "\uf023"
  },
  "mpris": {
    "ignored-players": [
      "brave"
    ],
    "format": "{status_icon}  <b>{title} - {artist}</b>",
    "format-paused": "{status_icon}    {title} - {artist}",
    "format-stopped": "{player_icon}",
    "player-icons": {
      "default": "\uf001"
    },
    "status-icons": {
      "playing": "\uf500",
      "paused": "\uf28c"
    },
    "tooltip": false
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "\uf0a2<span foreground='red'><sup>\uf444</sup></span>",
      "none": "\uf0a2",
      "dnd-notification": "\uf1f7<span foreground='red'><sup>\uf444</sup></span>",
      "dnd-none": "\uf1f7",
      "inhibited-notification": "\uf0a2<span foreground='red'><sup>\uf444</sup></span>",
      "inhibited-none": "\uf0a2",
      "dnd-inhibited-notification": "\uf1f7<span foreground='red'><sup>\uf444</sup></span>",
      "dnd-inhibited-none": "\uf1f7"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/htb_vpn": {
    "format": "VPN: {}",
    "exec": "cat /tmp/htb_vpn_ip 2>/dev/null",
    "interval": 5,
    "on-click": "cat /tmp/htb_vpn_ip | wl-copy",
    "signal": 8
  },
  "custom/htb_target": {
    "format": "Target: {}",
    "exec": "cat /tmp/htb_target_ip 2>/dev/null",
    "interval": 5,
    "on-click": "cat /tmp/htb_target_ip | wl-copy",
    "signal": 9
  }
}