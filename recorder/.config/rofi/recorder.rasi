/**
 * Rofi Theme for GPU Screen Recorder
 * ~/.config/rofi/recorder.rasi
 * Theme: Code Red
 */

* {
    background-color: #0d0d0d;
    text-color: #e6e6e6;
    border-color: #ff0012;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    border: 2px solid;
    border-radius: 10px;
    padding: 15px;
    width: 350px;
}

mainbox {
    spacing: 10px;
}

inputbar {
    spacing: 8px;
    text-color: #ff0012;
    padding: 0px 0px 10px 0px;
}

prompt {
    text-color: #ff0012;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    text-color: #e6e6e6;
}

listview {
    fixed-height: false;
    spacing: 5px;
    lines: 5;
}

element {
    padding: 8px;
    border-radius: 6px;
}

element selected {
    background-color: #ff0012;
    text-color: #0d0d0d;
    border: 1px solid;
    border-color: #ff0012;
}
